config global 'config'
	option enabled '0'
	option mode 'rule'
	option core_path '/usr/bin/sing-box'
	option config_path '/etc/openaero/run_config.json'
	option socks_port '10808'
	option http_port '10809'
	option tproxy_port '10810'
	option tun_name 'openaero0'
	option auto_route '1'
	option strict_route '1'

config watchdog 'watchdog'
	option enabled '1'
	option check_interval '5'
	option target_ip '223.5.5.5'
	option fail_threshold '3'
	option auto_fallback '1'

config singmatrix 'prewarm'
	option enabled '1'
	option server_port '39999'
	option lan_prewarm '1'

config subscription 'sub'
	option url ''
	option auto_update '1'
	option update_time '04:00'
